# Copia este archivo a .env y cambia los valores.

# Conexión a PostgreSQL.
DATABASE_URL=postgres://micolmena:micolmena@localhost:5432/micolmena?sslmode=disable

# Clave para firmar los tokens. Mínimo 32 caracteres; genera una con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Duración de la sesión.
TOKEN_TTL=24h

# Dirección donde escucha la API.
ADDR=:8080

# Orígenes del frontend permitidos, separados por comas.
CORS_ORIGINS=http://localhost:5173

# Primer administrador. Se crea solo si todavía no existe ninguno.
ADMIN_EMAIL=admin@micolmena.local
ADMIN_PASSWORD=cambia-esta-contraseña

# --- Protección contra fuerza bruta ---

# Pon true SOLO si la API corre detrás de un proxy de confianza (Caddy, Nginx…) que añade la IP real
# del cliente al final de X-Forwarded-For. Con true y sin proxy, cualquiera puede falsificar su IP
# y esquivar el límite. Con false y con proxy, todos los usuarios compartirán la IP del proxy.
TRUST_PROXY=false

# Intentos por minuto y por IP en /api/auth/login y /api/auth/register.
AUTH_RATE_PER_MIN=10

# Fallos de contraseña seguidos de un mismo email que lo bloquean, y cuánto dura el bloqueo.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT=15m

# --- Adjuntos ---

# Carpeta donde se guardan los archivos adjuntos (inclúyela en las copias de seguridad).
UPLOAD_DIR=data/uploads
# Tamaño máximo de cada archivo, en MB.
MAX_UPLOAD_MB=10

# --- Correo ---

# Dirección del frontend, para los enlaces de los correos.
APP_URL=http://localhost:5173

# Servidor SMTP de tu proveedor (Brevo, Resend, Amazon SES, Gmail…). Sin SMTP_HOST, los correos
# no se envían: se escriben en el log de la API (útil en desarrollo para ver los enlaces).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MiColmena <soporte@tudominio.com>
